{
  "openapi": "3.0.0",
  "info": {
    "title": "EventPulse API",
    "version": "1.0.0",
    "description": "API Documentation for EventPulse System"
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Local Server"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Check server health",
        "responses": {
          "200": { "description": "Server is healthy" }
        }
      }
    }
  }
}